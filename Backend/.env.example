# Environment variables for GitHub Repository Explainer (100% GPU VRAM Hybrid Mode)

# Local Ollama Server
OLLAMA_BASE_URL=http://localhost:11434

# 100% GPU-Resident Configuration for 4GB GPU VRAM:
OLLAMA_FAST_MODEL=qwen2.5-coder:3b
OLLAMA_SMART_MODEL=qwen2.5-coder:3b

# Optional: GitHub Personal Access Token (raises rate limit from 60 to 5,000 req/hr)
GITHUB_TOKEN=your_github_personal_access_token_here
